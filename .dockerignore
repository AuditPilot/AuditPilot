# Keep Docker build contexts small and secret-free.
# Frontend build context: package manifests, client/, shared/, Vite config,
# and docker/nginx/ only.

# dependencies & build output
node_modules
**/node_modules
dist
**/dist

# version control & editor
.git
.gitignore
.vscode
.idea

# secrets — never bake these into images
.env
.env.*
!.env.example

# local scratch
temp
temp/
*.log
.DS_Store
Thumbs.db

# docker files themselves (they are read by the engine, not the build)
Dockerfile*
docker-compose*.yml
